# ==============================================================================
# Nottura Admin Panel - Environment Variables
# Copy file ini menjadi `.env.local` untuk development lokal.
# ==============================================================================

# URL Project Supabase & Anon Key (ambil dari Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mode Autentikasi:
# - "dummy"    : Fase 1 (Development/Lokal saja). Login pakai username `nottura` & password `123`.
#                CATATAN KEAMANAN: Mode dummy otomatis DITOLAK paksa saat `NODE_ENV=production`
#                agar kredensial dummy tidak pernah aktif di produksi.
# - "supabase" : Fase 2 (Production). Wajib menggunakan Google OAuth + tabel `admin_whitelist`.
NEXT_PUBLIC_AUTH_MODE=dummy
